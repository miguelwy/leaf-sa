# --- Database -----------------------------------------------------------------
# Local Docker (docker compose up -d mongo):
MONGODB_URI=mongodb://sa:sa-local-password@localhost:27017/?directConnection=true&authSource=admin
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sa_workspace

# --- Authentication -----------------------------------------------------------
# Secret used to sign session cookies. At least 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# --- Docker Compose only --------------------------------------------------------
# Credentials for the local MongoDB container (must match MONGODB_URI above).
MONGO_ROOT_USERNAME=sa
MONGO_ROOT_PASSWORD=sa-local-password

# --- AI meeting analysis -----------------------------------------------------------
# Keys stay on the server. Nothing is sent to a provider until AI processing is
# approved in Settings -> AI processing (and only for meetings you analyze).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional model overrides (Settings can also set the model):
# AI_ANTHROPIC_MODEL=claude-opus-5-5
# AI_OPENAI_MODEL=
# Deployment kill switch: set to false to disable AI regardless of Settings.
# AI_PROCESSING_ENABLED=true
# Cost tracking for models without built-in prices (USD per 1M tokens):
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=
